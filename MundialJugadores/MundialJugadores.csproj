<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>MundialJugadores</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Los archivos de datos se copian a la carpeta de salida para que el programa
         pueda leerlos y sobre-escribirlos (persistencia) al ejecutarse. -->
    <None Update="Datos\jugadores.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Datos\jugadores.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
